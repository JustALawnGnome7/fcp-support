{
  "_note": "ALSA control map for the Clarett 8Pre USB (1235:8208) under the kernel's fcp driver, paired with fcp-devmap-8208.json. Control names follow the scarlett2 driver's for this model.",
  "input-controls": {
    "air": {
      "name": "Line In %d Air Capture Switch",
      "type": "bool"
    },
    "level": {
      "name": "Line In %d Level Capture Enum",
      "type": "enum",
      "values": [
        "Line",
        "Inst"
      ]
    }
  },
  "output-controls": {
    "level": {
      "name": "Line %02d Playback Volume",
      "type": "int",
      "min": -127,
      "max": 0,
      "db-min": -127,
      "db-max": 0,
      "hw-follow": {
        "switch": "hw-gain",
        "source": "masterVolume"
      }
    },
    "mute": {
      "name": "Line %02d Mute Playback Switch",
      "type": "bool",
      "hw-follow": {
        "switch": "hw-gain",
        "source": "muteSwitch"
      }
    },
    "hw-gain": {
      "name": "Line Out %02d Volume Control Playback Enum",
      "type": "enum",
      "values": [
        "SW",
        "HW"
      ]
    }
  },
  "output-link": [],
  "global-controls": {
    "versionStageRelease": {
      "name": "Firmware Version",
      "interface": "card",
      "access": "readonly",
      "type": "int"
    },
    "muteSwitch": {
      "name": "Mute Playback Switch",
      "type": "bool"
    },
    "dimSwitch": {
      "name": "Dim Playback Switch",
      "type": "bool"
    },
    "masterVolume": {
      "name": "Master HW Playback Volume",
      "type": "int",
      "access": "readonly",
      "min": -127,
      "max": 0,
      "db-min": -127,
      "db-max": 0
    },
    "standalone": {
      "name": "Standalone Switch",
      "type": "bool"
    },
    "spdifSource": {
      "name": "S/PDIF Source Capture Enum",
      "type": "enum",
      "values": [
        "None",
        "Optical",
        "RCA"
      ]
    }
  },
