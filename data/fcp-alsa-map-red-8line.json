    "air": {
      "name": "Line In %d Air Capture Switch",
      "type": "bool"
    },
    "mli3": {
      "name": "Line In %d Level Capture Enum",
      "type": "enum",
      "values": [
        {
          "name": "Mic",
          "value": 0
        },
        {
          "name": "Line",
          "value": 1
        },
        {
          "name": "Inst",
          "value": 2
        }
      ]
    },
    "phantom": {
      "name": "Line In %d Phantom Power Capture Switch",
      "type": "bool"
    },
    "hpf": {
      "name": "Line In %d High Pass Filter Capture Switch",
      "type": "bool"
    },
    "phase": {
      "name": "Line In %d Phase Invert Capture Switch",
      "type": "bool"
    },
    "stereo-link": {
      "name": "Line In %d Stereo Link Capture Switch",
      "type": "bool"
    }
  },
  "output-controls": {
    "level": {
      "name": "Line %d Playback Volume",
      "type": "int",
      "min": -112,
      "max": 0,
      "db-min": -112,
      "db-max": 0
    },
    "mute": {
      "name": "Line %d Mute Playback Switch",
      "type": "bool-bitmap"
    },
    "dim": {
      "name": "Line %d Dim Playback Switch",
      "type": "bool-bitmap"
    },
    "hw-gain": {
      "name": "Line Out %d Volume Control Playback Enum",
      "type": "bool-bitmap"
    }
  },
  "output-link": [],
  "global-controls": {
    "versionStageRelease": {
      "name": "Firmware Version",
      "interface": "card",
      "access": "readonly",
      "type": "int"
    }
  },
